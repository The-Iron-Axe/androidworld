# Copy this file to config.env and adjust if your AutoDL SSH changes.
# DO NOT run the tunnel while an unrelated AVD workload needs the machine
# exclusively; the tunnel itself does not touch AVD, but keep agent/ADB idle.
AUTODL_SSH_HOST=connect.nmb1.seetacloud.com
AUTODL_SSH_PORT=46572
LOCAL_PORT=18180
REMOTE_PORT=6006
RAG_URL=http://127.0.0.1:18180
